# ============================================================================
#  Configuración de Sway — modular (OpenDesk)
# ============================================================================
# Este archivo es el punto de entrada: únicamente carga los módulos que
# componen la configuración. Reemplaza al default de openSUSE + los includes
# de /etc/sway/config.d/*: todo lo que traían 50-openSUSE.conf y
# 55-openSUSE-windows.conf está integrado en estos módulos.
#
# Organización del árbol (rutas relativas a este archivo):
#   features/     — variables, monitores, entrada, apariencia, energía,
#                   autostart, workspaces, ventanas, notificaciones,
#                   capturas y portapapeles
#   keybindings/  — atajos por área (aplicaciones, navegación, workspaces,
#                   media, sistema, swaydesk)
#   modes/        — modos de entrada (redimensionar, lanzador)
#   hosts/        — particularidades por máquina (desktop, laptop, dock)
#
# El orden de los includes importa: las variables globales se definen primero
# y los modos se cargan antes de los atajos que los referencian.
#
# Referencia completa: man 5 sway
# Nombre de outputs/inputs: swaymsg -t get_outputs / swaymsg -t get_inputs

# ----------------------------------------------------------------------------
# Features base (en orden de dependencia)
# ----------------------------------------------------------------------------
include features/variables-colors.conf
include features/monitors.conf
include features/inputs.conf
include features/appearance.conf
include features/power.conf

# ----------------------------------------------------------------------------
# Modos (antes de los atajos que los referencian)
# ----------------------------------------------------------------------------
include modes/resize.conf
include modes/launcher.conf

# ----------------------------------------------------------------------------
# Atajos
# ----------------------------------------------------------------------------
include keybindings/applications.conf
include keybindings/navigation.conf
include keybindings/workspaces.conf
include keybindings/media.conf
include keybindings/system.conf
include keybindings/swaydesk.conf

# ----------------------------------------------------------------------------
# Utilidades y arranque
# ----------------------------------------------------------------------------
include features/screenshots.conf
include features/notifications.conf
include features/windows.conf
include features/autostart.conf
include features/workspaces.conf
include features/clipboard.conf

# ----------------------------------------------------------------------------
# Hosts (reservados)
# ----------------------------------------------------------------------------
include hosts/desktop.conf
include hosts/laptop.conf
include hosts/dock.conf
