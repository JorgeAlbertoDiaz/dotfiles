{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 380,
  "control-center-margin-top": 5,
  "control-center-margin-bottom": 5,
  "control-center-margin-right": 5,
  "control-center-margin-left": 5,
  "notification-window-width": 380,
  "notification-grouping": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "menubar",
    "label#quick-access",
    "mpris",
    "volume",
    "buttons-grid",
    "inhibitors",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "label#quick-access": {
      "text": "Acceso Rápido",
      "max-lines": 1
    },
    "menubar": {
      "buttons#toggles": {
        "position": "left",
        "actions": [
          {
            "label": "󰤨",
            "command": "foot -e nmtui"
          },
          {
            "label": "󰂯",
            "command": "foot -e bluetuith"
          },
          {
            "label": "󰂚",
            "command": "swaync-client -d -sw"
          },
          {
            "label": "󰄄",
            "command": "grim -g \"$(slurp)\" - | swappy -f -"
          }
        ]
      },
      "menu#power": {
        "label": "⏻",
        "position": "right",
        "actions": [
          { "label": "Bloquear", "command": "swaylock -f" },
          { "label": "Suspender", "command": "systemctl suspend" },
          { "label": "Reiniciar", "command": "systemctl reboot" },
          { "label": "Apagar", "command": "systemctl poweroff" },
          { "label": "Salir de sway", "command": "swaymsg exit" }
        ]
      }
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true
    },
    "volume": {
      "label": "Volumen",
      "show-per-app": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰄄",
          "command": "grim -g \"$(slurp)\" - | swappy -f -"
        },
        {
          "label": "󰌪",
          "command": "powerprofilesctl set power-saver"
        },
        {
          "label": "⏻",
          "command": "wlogout"
        },
        {
          "label": "",
          "command": "foot -e nmtui"
        },
        {
          "label": "",
          "command": "foot -e bluetuith"
        },
        {
          "label": "",
          "command": "foot -e htop"
        }
      ]
    },
    "inhibitors": {
      "text": "Inhibidores",
      "clear-all-button": false
    },
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },
    "dnd": {
      "text": "No Perturbe"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
