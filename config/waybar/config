{
    "layer": "top",
    "position": "top",

    "modules-left": [
        "sway/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],

    "clock": {
        "format": "{:%d/%m/%Y %H:%M}"
    },

    "cpu": {
        "format": " {usage}%"
    },

    "memory": {
        "format": " {used:0.1f}GiB"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 desconectado"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": "󰝟 muted"
    },

    "battery": {
        "format": " {capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}